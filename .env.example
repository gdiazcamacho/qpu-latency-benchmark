# Copy this file to .env and fill in the values you need.
# .env is gitignored -- never commit it.
#
# Only the QExa20 backend (LRZ, via MQSS) needs credentials.
# The fake and qmio backends run without any of these.

# Required for --backend qexa20
MQSS_TOKEN=

# Optional: backend name on the MQSS side (default: QExa20)
MQSS_BACKEND=

# Optional: override the MQSS endpoint (default: the adapter's built-in URL)
MQSS_URL=
MQSS_PORT=
