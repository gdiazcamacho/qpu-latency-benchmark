version: 0.1.0
date-released: "2026-09-28"
license: Apache-2.0
repository-code: "https://github.com/gdiazcamacho/qpu-latency-benchmark"
keywords:
  - quantum computing
  - benchmarking
  - latency
  - HPC-QC integration
