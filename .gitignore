# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Conda
.conda/
conda-meta/

# Jupyter
.ipynb_checkpoints/
notebooks/*.ipynb

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and SLURM output
*.log
*.out
*.err
slurm-*.out
slurm-*.err

# Coverage / testing
.coverage
.pytest_cache/
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Results: databases and generated outputs stay out of the repository
*.sqlite
*.sqlite3
*.db
output/raw/*
output/figures/*
output/reports/*
!output/raw/.gitkeep
!output/figures/.gitkeep
!output/reports/.gitkeep

# Temporary files
*.tmp
*.bak
*.swp

# Secrets and credentials
.env
.env.*
!.env.example
token.txt
credentials.json
